# 실제 값을 여기에 넣지 않는다. 복사해서 .env.local 을 만들고 거기에만 값을 채운다.
# .env* 는 .gitignore 로 제외되며 이 예시 파일만 저장소에 포함한다.

# --- 브라우저에 노출되는 공개 값 (Supabase Auth 전용) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase Auth redirect 및 서버 redirect에 사용할 명시적 앱 origin
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# 선택적 추가 로컬 origin (canonical은 위 127.0.0.1이며 localhost도 개발용으로 허용)
NEXT_PUBLIC_ALLOWED_ORIGINS=http://localhost:3000

# --- 서버 전용. NEXT_PUBLIC_ 접두사를 절대 붙이지 않는다. ---
# service-role 키는 RLS 를 우회하므로 서버 모듈에서만 읽고 로그·응답에 출력하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# --- 통합 테스트 전용 (npm run test:integration) ---
# 아래 두 값이 모두 없으면 통합 테스트는 통과하지 않고 즉시 실패한다.
# 운영 DB 를 절대 지정하지 않는다. 파괴적 테스트가 실행된다.
TEST_SUPABASE_URL=
TEST_SUPABASE_SERVICE_ROLE_KEY=
# 격리된 테스트 DB 임을 명시적으로 확인했다는 표시. 정확히 "true" 여야 한다.
TEST_DB_ISOLATED=
